# ── Kafka Memory Sharing Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# Based on cbt-chat NPR Kafka patterns (SCRAM-SHA-512 authentication)

# Kafka broker connection (pipe-separated, same format as cbt-chat .env)
KAFKA_BROKERS="b-1.your-cluster.kafka.region.amazonaws.com:9096|b-2.your-cluster.kafka.region.amazonaws.com:9096"
KAFKA_CLIENT_ID="ltm-mcp"
KAFKA_MECHANISM="scram-sha-512"
KAFKA_USERNAME=""
KAFKA_PASSWORD=""

# Topic for shared memories
KAFKA_TOPIC="ltm-project-memories"

# ── Access Control ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed users who may produce to the topic.
# Each entry is "username:node_uuid" matching the identity.json values.
# Only users listed here can produce memories to Kafka.
# Consumers also validate delete events against this list — a delete RPC
# is only honoured if the source user appears in the consumer's allow-list.
#
# Find your identity in data/identity.json (auto-created on first run).
#
# Example:
# ALLOWED_KAFKA_USERS="Ohan:019532ab-1234-7000-8000-abcdef012345,Alice:019532ab-5678-7000-8000-abcdef678901"
ALLOWED_KAFKA_USERS=""
